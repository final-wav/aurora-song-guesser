{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurora-song-guesser",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD_KV",
      "id": "57267448142f47b185c84ff82adb3289"
    }
  ],
  "observability": {
    "enabled": true
  }
}
